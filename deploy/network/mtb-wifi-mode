#!/bin/bash
set -euo pipefail

CONFIG_FILE=/etc/mtb-wifi-mode.conf

if [[ ! -r "$CONFIG_FILE" ]]; then
    echo "Missing $CONFIG_FILE" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

: "${HOME_CONNECTION_NAME:?HOME_CONNECTION_NAME must be set}"
: "${WLAN_INTERFACE:=wlan0}"
: "${HOME_CONNECT_TIMEOUT:=30}"

is_home_connected() {
    local connection state
    connection="$(nmcli -g GENERAL.CONNECTION device show "$WLAN_INTERFACE" 2>/dev/null || true)"
    state="$(nmcli -g GENERAL.STATE device show "$WLAN_INTERFACE" 2>/dev/null || true)"
    [[ "$connection" == "$HOME_CONNECTION_NAME" && "$state" == 100* ]]
}

stop_access_point() {
    systemctl stop mtb-dnsmasq.service mtb-hostapd.service 2>/dev/null || true
}

start_client_mode() {
    stop_access_point
    nmcli device set "$WLAN_INTERFACE" managed yes

    local deadline attempt_timeout
    deadline=$(( $(date +%s) + HOME_CONNECT_TIMEOUT ))

    while (( $(date +%s) < deadline )); do
        if is_home_connected; then
            return 0
        fi

        attempt_timeout=$(( deadline - $(date +%s) ))
        (( attempt_timeout > 0 )) || break
        if (( attempt_timeout > 5 )); then
            attempt_timeout=5
        fi
        nmcli -w "$attempt_timeout" connection up id "$HOME_CONNECTION_NAME" ifname "$WLAN_INTERFACE" || true
    done

    is_home_connected
}

start_access_point() {
    stop_access_point
    nmcli device disconnect "$WLAN_INTERFACE" 2>/dev/null || true
    nmcli device set "$WLAN_INTERFACE" managed no
    ip addr flush dev "$WLAN_INTERFACE"
    ip addr add 192.168.10.1/24 dev "$WLAN_INTERFACE"
    ip link set "$WLAN_INTERFACE" up
    systemctl start mtb-hostapd.service mtb-dnsmasq.service
}

case "${1:-}" in
    start)
        if ! command -v nmcli >/dev/null; then
            echo "NetworkManager (nmcli) is required; refusing to change networking." >&2
            exit 1
        fi

        if start_client_mode; then
            logger -t mtb-wifi-mode "home Wi-Fi connected: $HOME_CONNECTION_NAME"
        else
            logger -t mtb-wifi-mode "home Wi-Fi unavailable after ${HOME_CONNECT_TIMEOUT}s; starting access point"
            start_access_point
        fi
        ;;
    stop)
        stop_access_point
        ip addr flush dev "$WLAN_INTERFACE" 2>/dev/null || true
        nmcli device set "$WLAN_INTERFACE" managed yes 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 2
        ;;
esac