[Unit]
Description=MTB Telemetry Button Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mtb_telemetry
ExecStart=/bin/bash /home/pi/mtb_telemetry/scripts/start_button_logger.sh
Restart=always
RestartSec=2
Environment=CONTROL_MODE=button
Environment=CONTROL_GPIO=27
Environment=CONTROL_DEBOUNCE_MS=120
Environment=SHUTDOWN_GPIO=22
Environment=SHUTDOWN_DEBOUNCE_MS=800
Environment=STATUS_LED_GPIO=23
Environment=STATUS_LED_ACTIVE_LOW=0
Environment=TARGET_HZ=500
Environment=ADC_SAMPLES=1
Environment=CSV_FLUSH_EVERY=200

[Install]
WantedBy=multi-user.target
